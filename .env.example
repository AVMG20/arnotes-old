# Public URL used to access Taskmanager. Use HTTPS in production.
BETTER_AUTH_URL=http://localhost:3000
# Extra origins that may sign in, comma separated (a tunnel in front of a dev server, say)
# BETTER_AUTH_TRUSTED_ORIGINS=https://4500.example.com
APP_PORT=3000

# Docker Compose database URL. Keep the `postgres` hostname: Compose reads this
# file, so pointing it at localhost would leave the app container with no database.
# Outside Docker the `postgres` host is rewritten to localhost automatically, so
# native development works against the published port without editing this value.
DATABASE_URL=postgresql://arnotes:arnotes@postgres:5432/arnotes

# Optional. Docker generates and persists a secret when this is empty.
# Set a stable 32+ character value for production or non-Docker deployments.
BETTER_AUTH_SECRET=

# Optional in Docker and the Nix module, which generate one into the data directory; required elsewhere.
# 32 random bytes: `openssl rand -hex 32`. Back it up apart from the database: without it every stored
# secret is unreadable. Do not change it.
SECRETS_ENCRYPTION_KEY=

# Allow new accounts. Set to false after creating your account when the instance
# should be private. Applies to every sign-in method, OAuth included: an existing
# user can still sign in with a linked provider, but nobody new gets an account.
ALLOW_SIGN_UP=true

# Optional Discord OAuth. Set all three values to enable the Discord button.
# Callback URL: ${BETTER_AUTH_URL}/api/auth/callback/discord
NUXT_PUBLIC_DISCORD_ENABLED=false
DISCORD_CLIENT_ID=
DISCORD_CLIENT_SECRET=

# Optional GitHub OAuth. Set all three values to enable the GitHub button.
# Callback URL: ${BETTER_AUTH_URL}/api/auth/callback/github
NUXT_PUBLIC_GITHUB_ENABLED=false
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=

# Optional Google OAuth. Set all three values to enable the Google button.
# Callback URL: ${BETTER_AUTH_URL}/api/auth/callback/google
# Google accepts plain http only for localhost; any other host needs HTTPS.
NUXT_PUBLIC_GOOGLE_ENABLED=false
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Optional sign-in through your own OpenID Connect server: Authentik, Authelia,
# Keycloak, Pocket ID, Kanidm. NUXT_PUBLIC_OIDC_NAME is the button label.
# Callback URL: ${BETTER_AUTH_URL}/api/auth/oauth2/callback/oidc
NUXT_PUBLIC_OIDC_ENABLED=false
NUXT_PUBLIC_OIDC_NAME=Single sign-on
OIDC_DISCOVERY_URL=
OIDC_CLIENT_ID=
OIDC_CLIENT_SECRET=

# Passkeys need no outside service and are on by default. A passkey belongs to
# the hostname in BETTER_AUTH_URL, so changing that hostname orphans them.
NUXT_PUBLIC_PASSKEYS_ENABLED=true

# Optional "Email me a code" sign-in. Needs an SMTP server; SMTP_HOST and
# SMTP_FROM are required, the rest depend on the server. SMTP_SECURE=true means
# TLS from the start (usually port 465); otherwise STARTTLS on 587 is used.
# For local development, Mailpit catches everything:
#   docker run -d -p 1025:1025 -p 8025:8025 axllent/mailpit
#   SMTP_HOST=localhost SMTP_PORT=1025, then read mail at http://localhost:8025
NUXT_PUBLIC_EMAIL_CODE_ENABLED=false
SMTP_HOST=
SMTP_PORT=
SMTP_SECURE=false
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=Taskmanager <taskmanager@example.com>

# Optional Web Push: a notification on your phone or desktop when Taskmanager is
# closed. Needs HTTPS (or localhost) and a VAPID key pair; make one with
#   node -e "const c=require('node:crypto');const k=c.generateKeyPairSync('ec',{namedCurve:'P-256'}).privateKey.export({format:'jwk'});console.log('VAPID_PUBLIC_KEY='+Buffer.concat([Buffer.from([4]),Buffer.from(k.x,'base64url'),Buffer.from(k.y,'base64url')]).toString('base64url'));console.log('VAPID_PRIVATE_KEY='+k.d)"
# VAPID_SUBJECT is how push services can reach you: a mailto: or https: URL.
# Keep the private key secret, and keep the pair: a new one drops every device.
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:admin@example.com

# Optional GitHub integration: link issues, pull requests and workflow runs to a
# task. Public repositories work without a token, at GitHub's lower rate limit.
# Keep GITHUB_TOKEN secret (a token with read access to the repos) and never
# commit a real one. The webhook is ${BETTER_AUTH_URL}/api/github/webhook, with
# content type application/json and the events issues, pull_request, check_run and
# workflow_run. GitHub signs its deliveries with GITHUB_WEBHOOK_SECRET, so set the
# same secret there; the receiver answers 503 until it is set here.
GITHUB_TOKEN=
GITHUB_WEBHOOK_SECRET=
# Comma-separated GitHub owners and orgs that links may point at, e.g. acme,acme-labs.
# Empty allows any owner the token can see. Set it in production: the token can
# read every repository it has access to.
GITHUB_ALLOWED_OWNERS=
# Testing only: point GitHub calls at a local stub. Ignored when NODE_ENV=production.
# GITHUB_API_URL=http://127.0.0.1:4010

# RabbitMQ for the GitHub delivery queue. In this change only the queue module reads it; the webhook starts using it with GH6b (then GitHub events get 503 without a broker). Compose needs RABBITMQ_PASSWORD instead (required, no default), URL-safe.
# RABBITMQ_URL=amqp://user:CHANGE_ME@127.0.0.1:5672/vhost

# Sprocket answered by Claude Code (Settings → Sprocket). It runs `claude -p` with the
# login of the account the server runs as, so only the instance admin may choose it
# unless SPROCKET_CLAUDE_FOR_ALL=true. The binary is found by itself in the usual places.
# SPROCKET_CLAUDE_BIN=/home/you/.local/bin/claude
# SPROCKET_CLAUDE_FOR_ALL=false
# SPROCKET_MCP_URL=http://localhost:3000/api/mcp

# Public client setting for native development. Compose derives this from the
# server setting above.
NUXT_PUBLIC_ALLOW_SIGN_UP=true
